# 复制本文件为同目录的 model.env，再填写。model.env 已被 git 忽略，不要把密钥写回 example。
# 下面三个键都有值时，评测才会执行 tasks/model.json。缺任何一个时，模型任务在报告里记为跳过。
# 同名环境变量优先于本文件，便于临时换一个模型。

WPA_EVAL_BASE_URL=
WPA_EVAL_API_KEY=
WPA_EVAL_MODEL=

# 可选。OCR 不填时，需要识别图片或 PDF 的模型任务会缺少 OCR 配置。
# WPA_EVAL_MAX_STEPS=30
# WPA_EVAL_OCR_BASE_URL=
# WPA_EVAL_OCR_API_KEY=
# WPA_EVAL_OCR_MODEL=
# WPA_EVAL_OCR_TYPE=OpenAI-chat-completions-image_url
