# Build and Release Folders
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/

# Other files and folders
.settings/

# Executables
*.swf
*.air
*.ipa
*.apk

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.

node_modules/

# Evaluation outputs (reports, traces, browser profiles) and the browsers the setup script downloads
eval/out/
eval/browsers/

# Local model API for the eval harness. Copy eval/model.env.example and fill it in.
eval/model.env

# Agent tooling workspaces and the sibling pageagent project
.cursor/
.mimocode/
pageagent

# Local planning notes, not tracked
PLAN.md
AGENTS.md
OPTIMIZATION.md

# Installer outputs next to the scripts
WebpageAgent-*/
WebpageAgent-Latest
*.zip
