{
  "manifest_version": 3,
  "name": "网页智能体助手",
    "version": "6.5.1",
  "description": "网页智能体（Webpage Agent）：通过大模型自动操作当前网页，理解页面、填写表单、点击、上传已附加文件等。",
  "minimum_chrome_version": "109",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "offscreen", "downloads", "unlimitedStorage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "网页智能体助手"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
